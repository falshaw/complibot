# --- Database / cache (docker-compose.yml reads these) ---
POSTGRES_PASSWORD=change-me-postgres-superuser
COMPLIBOT_DB_PASSWORD=change-me-app-db-user
REDIS_PASSWORD=change-me-redis

# Used by `npm run dev`, Prisma CLI and the seed script when running outside Docker
DATABASE_URL=postgresql://postgres:change-me-postgres-superuser@localhost:5437/complibot
REDIS_HOST=localhost
REDIS_PORT=6384

# --- Auth / crypto ---
# openssl rand -base64 32
AUTH_SECRET=replace-with-random-32-byte-base64
# 32-byte key for AES-256-GCM field encryption (openssl rand -hex 32)
ENCRYPTION_KEY=replace-with-random-32-byte-hex
NEXTAUTH_URL=http://localhost:3005

# --- LLM ---
# "ollama" (default) or "claude" (optional HTTP bridge, see README)
LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# Only used when LLM_PROVIDER=claude
CLAUDE_BRIDGE_URL=http://host.docker.internal:7777
CLAUDE_BRIDGE_TOKEN=
CLAUDE_MODEL=opus

# --- Optional ---
# Password for the seeded demo users (random if unset; printed by the seed script)
SEED_ADMIN_PASSWORD=
# Trust X-Forwarded-For for rate limiting when behind a reverse proxy
TRUST_PROXY=false
RATE_LIMIT_PER_MINUTE=100

# Development-only mock login (requires NODE_ENV=development)
USE_MOCK_AUTH=false
MOCK_AUTH_EMAIL=
MOCK_AUTH_PASSWORD=

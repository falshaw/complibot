# Copy to .env and replace every "change-me" value.
# Generate random values with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Use hex/alphanumeric values for the passwords: they are embedded in database URLs.

# --- Database / cache (required) ---
POSTGRES_PASSWORD=change-me-postgres-superuser
COMPLIBOT_DB_PASSWORD=change-me-app-db-user
REDIS_PASSWORD=change-me-redis

# --- Auth / crypto (required) ---
# Any long random string
AUTH_SECRET=change-me-auth-secret
# Exactly 64 hex characters (32 bytes) for AES-256-GCM field encryption
ENCRYPTION_KEY=change-me-64-hex-characters

# --- Demo data ---
# Password for the seeded admin@demo.com / reviewer@demo.com users.
# Leave empty to get a random one, printed by: docker compose logs complibot-init
SEED_ADMIN_PASSWORD=

# --- LLM ---
# "ollama" (default) or "claude" (optional HTTP bridge, see README)
LLM_PROVIDER=ollama
# Ollama as seen from inside the containers; the default reaches Ollama on the Docker host
OLLAMA_HOST=http://host.docker.internal:11434
# Chat model used to classify questions and draft answers (must be pulled in Ollama)
OLLAMA_MODEL=qwen2.5:7b
# Thinking models (gemma4, qwen3, ...) need thinking off for short answers; "none" does that
# on Ollama and is ignored by other models. Empty = do not send the parameter.
OLLAMA_REASONING_EFFORT=none
# Unload the chat model as soon as a batch (parse, generate all, KB import) finishes, so its
# RAM comes back at once instead of after Ollama's 5-minute keep-alive. false = keep it loaded.
OLLAMA_RELEASE_AFTER_BATCH=true
# Answers drafted in parallel. Empty = 1 on Ollama (one local model), 5 on the Claude bridge
LLM_CONCURRENCY=
# Optional embedding model for semantic search; "none" = keyword search only
EMBEDDING_MODEL=nomic-embed-text
# Only used when LLM_PROVIDER=claude
CLAUDE_BRIDGE_URL=http://host.docker.internal:7777
CLAUDE_BRIDGE_TOKEN=
CLAUDE_MODEL=sonnet

# --- Ports on 127.0.0.1 (change if already in use) ---
COMPLIBOT_PORT=3005
COMPLIBOT_DB_PORT=5437
COMPLIBOT_REDIS_PORT=6384
# Must match the URL you open in the browser
NEXTAUTH_URL=http://localhost:3005

# --- Optional ---
# Trust X-Forwarded-For for rate limiting when behind a reverse proxy
TRUST_PROXY=false
RATE_LIMIT_PER_MINUTE=100

# --- Local development only (npm run dev / prisma CLI on the host) ---
DATABASE_URL=postgresql://postgres:change-me-postgres-superuser@localhost:5437/complibot
REDIS_HOST=localhost
REDIS_PORT=6384
